# Copy to .env for local development. Do not commit .env.
# Replace every placeholder. These values are not production credentials.

DATABASE_URL=postgres://recipes:replace-with-local-password@127.0.0.1:5432/recipes
SESSION_SECRET=replace-with-at-least-32-random-characters
UPLOAD_DIR=./data/uploads

# Leave unset or "none" unless you intentionally enable paid extraction.
RECIPE_EXTRACT_PROVIDER=none
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MAX_TOKENS=1800
OPENROUTER_TIMEOUT_MS=25000
OPENROUTER_APP_TITLE=Family Recipe Book
# OPENROUTER_HTTP_REFERER=

# Required in production before the first account can be created.
# SETUP_SECRET=

# Set to 1 only when the app is behind the Compose proxy.
# TRUST_PROXY=1
