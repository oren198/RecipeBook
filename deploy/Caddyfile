# TLS terminates here. Set SITE_ADDRESS to the public hostname, for example recipes.example.com.
# Do not invent a domain. Caddy will not start usefully until SITE_ADDRESS is set.
{$SITE_ADDRESS} {
	encode gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		X-Frame-Options DENY
		-Server
	}
	reverse_proxy app:3000
}
